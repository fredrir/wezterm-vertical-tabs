+/// The pane's owner applies the ordinary local policy; a relay asks further along. A pane
+/// that is gone needs no prompt, and an owner that cannot answer keeps the prompt.
+async fn close_info(pane_id: PaneId) -> GetPaneCloseInfoResponse {
+    let Some(pane) = Mux::get().get_pane(pane_id) else {
+        return GetPaneCloseInfoResponse::default();
+    };
+    if let Some(relayed) = pane.downcast_ref::<wezterm_client::pane::ClientPane>() {
+        return relayed
+            .close_info()
+            .await
+            .unwrap_or(GetPaneCloseInfoResponse {
+                prompt: true,
+                process: String::new(),
+            });
+    }
+    let prompt = !pane.can_close_without_prompting(mux::pane::CloseReason::Pane);
+    let process = pane
+        .get_foreground_process_name(CachePolicy::AllowStale)
+        .and_then(|path| {
+            std::path::Path::new(&path)
+                .file_name()
+                .map(|name| name.to_string_lossy().into_owned())
+        })
+        .unwrap_or_default();
+    GetPaneCloseInfoResponse { prompt, process }
+}
+
+/// The named client domain, attached first when needed.
+async fn client_domain(name: &str) -> anyhow::Result<Arc<dyn Domain>> {
+    let domain = Mux::get()
+        .get_domain_by_name(name)
+        .ok_or_else(|| anyhow!("no such domain {name}"))?;
+    anyhow::ensure!(
+        domain
+            .downcast_ref::<wezterm_client::domain::ClientDomain>()
+            .is_some(),
+        "{name} is not a client domain"
+    );
+    if domain.state() == DomainState::Detached {
+        domain.attach(None).await?;
+    }
+    Ok(domain)
+}
+
+async fn adoptable_panes(name: &str) -> anyhow::Result<Vec<PaneEntry>> {
+    let domain = client_domain(name).await?;
+    let client = domain
+        .downcast_ref::<wezterm_client::domain::ClientDomain>()
+        .expect("checked by client_domain");
+    client.adoptable_panes().await
+}
+
+async fn adopt_pane(
+    name: &str,
+    remote_pane_id: PaneId,
+    window_id: Option<WindowId>,
+) -> anyhow::Result<(Arc<Tab>, WindowId, Arc<dyn Pane>)> {
+    let domain = client_domain(name).await?;
+    let client = domain
+        .downcast_ref::<wezterm_client::domain::ClientDomain>()
+        .expect("checked by client_domain");
+    client.adopt_pane(remote_pane_id, window_id).await
+}
+
+async fn pane_location(pane_id: PaneId) -> anyhow::Result<GetPaneLocationResponse> {
+    let pane = Mux::get()
+        .get_pane(pane_id)
+        .ok_or_else(|| anyhow!("no such pane {}", pane_id))?;
+    if let Some(relayed) = pane.downcast_ref::<wezterm_client::pane::ClientPane>() {
+        return relayed.relay_location().await;
+    }
+    let cwd = pane
+        .get_current_working_dir(CachePolicy::AllowStale)
+        .map(|url| url.path().to_owned())
+        .unwrap_or_default();
+    Ok(GetPaneLocationResponse {
+        home: mux::location::home(),
+        repo_root: mux::location::repo_root(&cwd),
+        cwd,
+    })
+}
+
+/// A pane this server merely relays belongs to the machine further along the chain.
+async fn host_info(pane_id: Option<PaneId>) -> GetHostInfoResponse {
+    if let Some(pane) = pane_id.and_then(|id| Mux::get().get_pane(id)) {
+        if let Some(relayed) = pane.downcast_ref::<wezterm_client::pane::ClientPane>() {
+            if let Ok(info) = relayed.relay_host_info().await {
+                return info;
+            }
+        }
+    }
+    GetHostInfoResponse {
+        os: sysinfo::System::distribution_id(),
+        hostname: sysinfo::System::host_name().unwrap_or_default(),
+    }
+}
+
+async fn replace_pane(
+    request: ReplacePane,
+    client_id: Option<Arc<ClientId>>,
+) -> anyhow::Result<Pdu> {
+    let mux = Mux::get();
+    let _identity = mux.with_identity(client_id);
+    let (_domain, window_id, tab_id) = mux
+        .resolve_pane_id(request.pane_id)
+        .ok_or_else(|| anyhow!("pane_id {} invalid", request.pane_id))?;
+    let (pane, size) = mux
+        .replace_pane(
+            request.pane_id,
+            request.command,
+            request.command_dir,
+            request.domain,
+            request.wait_for_ready,
+        )
+        .await?;
+    Ok(Pdu::SpawnResponse(SpawnResponse {
+        pane_id: pane.pane_id(),
+        tab_id,
+        window_id,
+        size,
+    }))
+}
