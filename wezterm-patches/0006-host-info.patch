+    /// `None` until the owning server answers, and for good from a stock server.
+    pub fn host_info(&self) -> Option<GetHostInfoResponse> {
+        self.host_info.lock().clone()
+    }
+
+    /// An intermediate mux answers for the pane's real owner rather than for itself.
+    pub async fn relay_host_info(&self) -> anyhow::Result<GetHostInfoResponse> {
+        if let Some(info) = self.host_info() {
+            return Ok(info);
+        }
+        let info = self
+            .client
+            .client
+            .get_host_info(GetHostInfo {
+                pane_id: Some(self.remote_pane_id),
+            })
+            .await?;
+        self.host_info.lock().replace(info.clone());
+        Ok(info)
+    }
