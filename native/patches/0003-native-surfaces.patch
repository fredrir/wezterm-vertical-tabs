+
+#[cfg(test)]
+mod native_window_decoration_tests {
+    use super::WindowDecorations;
+
+    #[test]
+    fn native_default_window_controls_match_the_platform() {
+        let decorations = WindowDecorations::default();
+        assert!(decorations.contains(WindowDecorations::RESIZE));
+        assert_eq!(
+            decorations.contains(WindowDecorations::INTEGRATED_BUTTONS),
+            cfg!(target_os = "macos")
+        );
+        assert_eq!(
+            decorations.contains(WindowDecorations::TITLE),
+            !cfg!(target_os = "macos")
+        );
+    }
+
+    #[test]
+    fn native_window_control_defaults_preserve_explicit_configuration() {
+        for (value, expected) in [
+            ("NONE", WindowDecorations::NONE),
+            (
+                "TITLE|RESIZE",
+                WindowDecorations::TITLE | WindowDecorations::RESIZE,
+            ),
+            (
+                "INTEGRATED_BUTTONS|RESIZE",
+                WindowDecorations::INTEGRATED_BUTTONS | WindowDecorations::RESIZE,
+            ),
+        ] {
+            assert_eq!(
+                WindowDecorations::try_from(value.to_owned()).unwrap(),
+                expected
+            );
+        }
     }
 }
 
