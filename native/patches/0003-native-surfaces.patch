+            (rect.x, rect.y, TOP_LEFT_ROUNDED_CORNER),
+            (
+                rect.x + rect.width - radius,
+                rect.y,
+                TOP_RIGHT_ROUNDED_CORNER,
+            ),
+            (
+                rect.x,
+                rect.y + rect.height - radius,
+                BOTTOM_LEFT_ROUNDED_CORNER,
+            ),
+            (
+                rect.x + rect.width - radius,
+                rect.y + rect.height - radius,
+                BOTTOM_RIGHT_ROUNDED_CORNER,
+            ),
+        ] {
+            self.poly_quad(
+                layers,
+                0,
+                euclid::point2(x, y),
+                corner,
+                0,
+                euclid::size2(radius, radius),
+                color,
+            )?
+            .set_grayscale();
+        }
