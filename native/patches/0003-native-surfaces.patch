+                rect.y,
+                rect.width - radius * 2.,
+                rect.height,
+            ),
+            (rect.x, rect.y + radius, radius, rect.height - radius * 2.),
+            (
+                rect.x + rect.width - radius,
+                rect.y + radius,
+                radius,
+                rect.height - radius * 2.,
+            ),
+        ] {
+            if width > 0. && height > 0. {
+                self.filled_rectangle(layers, 0, euclid::rect(x, y, width, height), color)?;
+            }
+        }
