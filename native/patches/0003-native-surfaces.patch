+    fn native_frame_covers_every_edge_without_reaching_terminal_cells() {
+        for dpi in [72., 96., 144., 192.] {
+            for (x, y, width, height) in [(256., 28., 960., 640.), (2., 38., 640., 480.)] {
+                let content = Bounds {
+                    x,
+                    y,
+                    width,
+                    height,
+                };
+                let frame = native_frame_geometry(content, dpi).unwrap();
+                let gutter = TermWindow::native_frame_gutter_impl(dpi);
+                let terminal = Bounds {
+                    x: x + gutter,
+                    y: y + gutter,
+                    width: width - 2. * gutter,
+                    height: height - 2. * gutter,
+                };
+                for (px, py) in [
+                    (x + width / 2., y + 0.5),
+                    (x + width / 2., y + height - 0.5),
+                    (x + 0.5, y + height / 2.),
+                    (x + width - 0.5, y + height / 2.),
+                ] {
+                    assert!(frame.strips.iter().any(|strip| strip.contains(px, py)));
+                }
+                for rect in frame.strips {
+                    assert!(rect.x >= content.x && rect.y >= content.y);
+                    assert!(rect.x + rect.width <= content.x + content.width);
+                    assert!(rect.y + rect.height <= content.y + content.height);
+                    assert!(
+                        rect.x + rect.width <= terminal.x
+                            || rect.x >= terminal.x + terminal.width
+                            || rect.y + rect.height <= terminal.y
+                            || rect.y >= terminal.y + terminal.height
+                    );
+                }
+                let edge = frame.strips[0].height;
+                assert_eq!(edge + frame.radius, gutter);
+            }
+        }
+        assert!(native_frame_geometry(Bounds::default(), 96.).is_none());
+        assert!(native_frame_geometry(
+            Bounds {
+                width: 10.,
+                height: 10.,
+                ..Bounds::default()
+            },
