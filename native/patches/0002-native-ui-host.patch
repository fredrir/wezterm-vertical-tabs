+                    vertex.position = [x,y]; vertex.tex = uv(x,y);
+                    vertex.fg_color[3] *= opacity; vertex.alt_color[3] *= opacity;
+                }
+                other.extend_with(layer, &vertices);
+            }
+        }
+    }
