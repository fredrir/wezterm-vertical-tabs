+#[cfg(test)]
+mod native_transform_tests {
+    use super::*;
+
+    fn close(actual: f32, expected: f32) {
+        assert!((actual - expected).abs() < 0.000_01, "{} != {}", actual, expected);
+    }
+
+    fn glyph(source: &mut HeapQuadAllocator, layer: usize) {
+        let mut quad = source.allocate(layer).unwrap();
+        quad.set_position(-30., -20., 50., 60.);
+        quad.set_texture_discrete(0.1, 0.9, 0.2, 1.);
+        quad.set_fg_color(LinearRgba::with_components(0.2, 0.3, 0.4, 0.8));
+        quad.set_alt_color_and_mix_value(LinearRgba::with_components(0.6, 0.5, 0.4, 0.4), 0.75);
+        quad.set_hsv(Some(HsbTransform { hue: 0.8, saturation: 0.7, brightness: 0.6 }));
+        quad.set_has_color(true);
+    }
+
+    #[test]
+    fn native_transform_clips_all_edges_and_preserves_texture_scale() {
+        let mut source = HeapQuadAllocator::default();
+        glyph(&mut source, 1);
+        let original = source.layer1[0].to_vertices();
+        let mut output = HeapQuadAllocator::default();
+        source.apply_transformed(&mut TripleLayerQuadAllocator::Heap(&mut output),
+            (10., 5.), 0.25, (0., 5., 40., 45.));
+        assert!(output.layer0.is_empty() && output.layer2.is_empty());
+        assert_eq!(output.layer1.len(), 1);
+        let vertices = output.layer1[0].to_vertices();
+        // The translated 80×80 glyph loses 20 pixels from each edge. Its
+        // texture must crop to the central half without stretching the glyph.
+        for (vertex, (position, texture)) in vertices.iter().zip([
+            ([0., 5.], [0.3, 0.4]), ([40., 5.], [0.7, 0.4]),
+            ([0., 45.], [0.3, 0.8]), ([40., 45.], [0.7, 0.8]),
+        ]) {
+            assert_eq!(vertex.position, position);
+            close(vertex.tex[0], texture[0]); close(vertex.tex[1], texture[1]);
+            close(vertex.fg_color[3], 0.2); close(vertex.alt_color[3], 0.1);
+            assert_eq!(&vertex.fg_color[..3], &original[0].fg_color[..3]);
+            assert_eq!(&vertex.alt_color[..3], &original[0].alt_color[..3]);
+            assert_eq!(vertex.hsv, original[0].hsv);
+            assert_eq!(vertex.has_color, IS_COLOR_EMOJI);
+            assert_eq!(vertex.mix_value, 0.75);
+        }
+        // Published cache contents remain reusable for later resize/effect frames.
+        assert_eq!(bytemuck::cast_slice::<Vertex, u8>(&original),
+            bytemuck::cast_slice::<Vertex, u8>(&source.layer1[0].to_vertices()));
+    }
+
+    #[test]
+    fn native_transform_reuses_all_layers_without_cumulative_translation_or_opacity() {
+        let mut source = HeapQuadAllocator::default();
+        for layer in 0..3 { glyph(&mut source, layer); }
+        for (offset, opacity) in [((0., 0.), 1.), ((17.5, -8.25), 0.5), ((-25., 40.), 0.)] {
+            let mut output = HeapQuadAllocator::default();
+            source.apply_transformed(&mut TripleLayerQuadAllocator::Heap(&mut output),
+                offset, opacity, (-1000., -1000., 1000., 1000.));
+            for layer in [&output.layer0, &output.layer1, &output.layer2] {
+                assert_eq!(layer.len(), 1);
+                let vertices = layer[0].to_vertices();
+                for (actual, original) in vertices.iter().zip(source.layer0[0].to_vertices()) {
+                    close(actual.position[0], original.position[0] + offset.0);
+                    close(actual.position[1], original.position[1] + offset.1);
+                    close(actual.tex[0], original.tex[0]); close(actual.tex[1], original.tex[1]);
+                    close(actual.fg_color[3], original.fg_color[3] * opacity);
+                    close(actual.alt_color[3], original.alt_color[3] * opacity);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn native_transform_drops_outside_edge_touching_and_degenerate_quads() {
+        let mut source = HeapQuadAllocator::default();
+        for (left, top, right, bottom) in [
+            (-20., 0., -1., 10.), (-10., 0., 0., 10.), (10., 0., 20., 10.),
+            (0., -10., 10., 0.), (0., 10., 10., 20.), (2., 2., 2., 8.), (2., 2., 8., 2.),
+        ] {
+            source.allocate(0).unwrap().set_position(left, top, right, bottom);
+        }
+        let mut output = HeapQuadAllocator::default();
+        source.apply_transformed(&mut TripleLayerQuadAllocator::Heap(&mut output),
+            (0., 0.), 1., (0., 0., 10., 10.));
+        assert!(output.layer0.is_empty());
+
+        // Cropping also preserves reversed atlas axes and fractional bounds.
+        let mut quad = source.allocate(2).unwrap();
+        quad.set_position(-0.5, -0.5, 1.5, 1.5);
+        quad.set_texture_discrete(1., 0., 0.75, 0.25);
+        source.apply_transformed(&mut TripleLayerQuadAllocator::Heap(&mut output),
+            (0., 0.), 1., (0., 0., 1., 1.));
+        assert!(output.layer0.is_empty());
+        assert_eq!(output.layer2.len(), 1);
+        let clipped = &output.layer2[0];
+        assert_eq!(clipped.position, (0., 0., 1., 1.));
+        assert_eq!(clipped.tex, (0.75, 0.25, 0.625, 0.375));
+    }
+}
